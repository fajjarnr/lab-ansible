{
  "name": "ansible-dev-tools",
  "image": "registry.redhat.io/ansible-automation-platform-26/ansible-dev-tools-rhel9:26.1.0",
  "containerUser": "root",
  "runArgs": [
    "--cap-add=CAP_MKNOD",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_RESOURCE",
    "--device",
    "/dev/fuse",
    "--security-opt",
    "seccomp=unconfined",
    "--security-opt",
    "label=disable",
    "--security-opt",
    "apparmor=unconfined",
    "--security-opt",
    "unmask=/sys/fs/cgroup",
    "--userns=host",
    "--hostname=ansible-dev-tools",
    "--name",
    "ansible-dev-tools"
  ],
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "redhat.vscode-redhat-account",
        "hashicorp.terraform",
        "hashicorp.hcl"
      ]
    }
  }
}
